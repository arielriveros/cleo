odel of the weapon in the hands, or null. */\n    private get _view(): any {\n        return this.weapon > 0 ? this._views[this.weapon - 1] ?? null : null\n    }\n\n    /** Seconds the weapon coming into the hands keeps them busy: its Equip clip in first person, the layer's fade in third. */\n    private _equipTime(fp: boolean): number {\n        if (this.weapon === 0) return 0\n        if (fp) {\n            const secs = this._playClip(this._view, 'Equip')\n            return Math.max(0.3, secs ?? this._gun?.equipSeconds ?? 0.5)\n        }\n        return this.equipSeconds\n    }\n\n    /**\n     * A reload, if one would fill anything and the weapon is up and not reloading already: in first person the\n     * viewmodel's clips (the shotgun's three: into the reload, the shells, out of it), the magazine filled near their\n     * end; in third person the Reload pose held for the gun's `reloadSeconds`.\n     */\n    private _tryReload(fp: boolean) {\n        const gun = this._gun\n        if (!gun || this.reloading || this._time < this._busyUntil || !gun.canReload) return\n        const token = ++this._reloadToken\n        this.reloading = true\n        const view = fp ? this._view : null\n        const fill = () => { if (token === this._reloadToken) gun.reload() }\n        const finish = () => { if (token === this._reloadToken) { this.reloading = false } }\n        const start = fp ? this._playClip(view, 'ReloadStart') : undefined\n        if (start !== undefined) {\n            this.after(start, () => {\n                if (token !== this._reloadToken) return\n                const shells = this._playClip(view, 'Reload') ?? 1.6\n                this.after(shells * 0.9, () => {\n                    if (token !== this._reloadToken) return\n                    fill()\n                    const end = this._playClip(view, 'ReloadEnd') ?? 0.9\n                    this._busyUntil = this._time + end\n                    this.after(end, finish)\n                })\n            })\n            this._busyUntil = Infinity\n            return\n        }\n        const secs = (fp ? this._playClip(view, 'Reload') : undefined) ?? gun.reloadSeconds\n        this._busyUntil = this._time + secs\n        this.after(secs * 0.82, fill)\n        this.after(secs, finish)\n    }\n\n    /**\n     * The trigger: the weapon in the hands (its SandboxGun) fires along the camera's aim once it is up, a round off its\n     * magazine a shot. Each shot comes back as `weapon:Shot`, whose recoil kicks the camera and the weapon (`_shot`);\n     * most of the camera's kick comes back. In first person the viewmodel plays the shot (its Fire clip, or AimFire\n     * down the sights; the shotgun pumps after).\n     */\n    private _fire(delta: number, holster: boolean, sprinting: boolean, fp: boolean, up: boolean) {\n        const gun = this._gun\n        const rig = this.cameraRig()\n        const camera = rig?.children.find(c => c.nodeType === 'camera') ?? rig\n        const moving = this.planarSpeed > 0.4\n        this.spreadNow = gun ? gun.spread(fp ? this.ads : this._aim, moving, this.sprinting, this.crouched, this.isGrounded) : 0\n        if (gun?.pull && rig && camera) {\n            camera.updateTransforms(camera.parent ? camera.parent.worldTransform : null)\n            const eye = camera.worldPosition\n            const look = MathUtils.directionFromAim(this._look, rig.yaw, rig.pitch)\n            const weight = [this.pistolWeight, this.rifleWeight, this.shotgunWeight][this.weapon - 1] ?? 0\n            const ready = !holster && !sprinting && up && !this.reloading && (fp || (weight >= 0.95 && this._aim >= this.fireAimReady))\n            const view = { firstPerson: fp, muzzle: fp ? this._muzzleDrawn() : null }\n            const recoil = gun.pull(!holster && Input.pressed('Fire'), ready, eye, look, this.spreadNow, (this.collider as ColliderNode | null)?.body ?? null, view)\n            if (recoil && fp) {\n                const clip = this.ads > 0.5 && gun.aimClips ? 'AimFire' : 'Fire'\n                this._playClip(this._view, clip)\n                if (gun.pellets > 1) {\n                    const token = this._reloadToken\n                    this.after(0.35, () => { if (token === this._reloadToken && !this.reloading) this._playClip(this._view, 'Pump') })\n                }\n            }\n        }\n        // The camera's kick coming back: a share of it, faster the more is left (Firing Line's).\n        if (rig && this._recoilBack > 5e-4 && delta > 0) {\n            const back = Math.min(this._recoilBack, (this._recoilBack * this.recoilRecoverySpeed + 0.4) * delta)\n            rig.pitch = rig.pitch + back\n            this._recoilBack -= back\n        }\n    }\n\n    /**\n     * First person, every frame: the viewmodel of the weapon in the hands shown once the camera is in at the eyes, its\n     * animator told what the body does (Moving, Sprinting, Aim), brought in to the sights as it aims, kept out of walls,\n     * the lens narrowed and the mouse slowed down the sights, the background softened (depth of field).\n     */\n    private _firstPersonToward(delta: number, fp: boolean) {\n        const rig = this.cameraRig() as any\n        const mix = rig?.firstPersonMix ?? (fp ? 1 : 0)\n        const shown = fp && mix > 0.8\n        this._views.forEach((v, k) => { if (v && v.visible !== (shown && this.weapon === k + 1)) v.visible = shown && this.weapon === k + 1 })\n        // The eye: standing or crouched, eased; the lens: Firing Line's, narrowing down the sights.\n        this.eyeHeight = MathUtils.damp(this.eyeHeight, this.crouched ? this.eyeCrouch : this.eyeStand, 2.2 / Math.max(0.02, this.crouchSmoothing), delta)\n        const gun = this._gun\n        const fovGoal = this.hipFov + (this.sprinting ? this.sprintFovBoost : 0)\n        this.viewFov = MathUtils.damp(this.viewFov, gun ? lerp(fovGoal, gun.aimFov, this.ads) : fovGoal, 14, delta)\n        if (rig) {\n            if (this._baseYawSens < 0) { this._baseYawSens = rig.yawSensitivity; this._basePitchSens = rig.pitchSensitivity }\n            const sens = lerp(1, this.adsSensitivity, this.ads)\n            rig.yawSensitivity = this._baseYawSens * sens\n            rig.pitchSensitivity = this._basePitchSens * sens\n        }\n        if (!shown) { this._depthOfField(delta, 0); return }\n        const moving = this.planarSpeed > 0.4\n        this._setViewParam('Moving', moving)\n        this._setViewParam('Sprinting', moving && this.sprinting)\n        this._setViewParam('Aim', this.ads > 0.4 && !!gun?.aimClips)\n        // Aimed without aim clips, the whole viewmodel comes in to the sights; with them, a touch up.\n        const g = this._viewmodels\n        if (g && gun) {\n            const shift = gun.aimClips ? [0, this.aimClipRaise, 0] : gun.aimOffset\n            const t = this.ads\n            g.setPosition([this._vmBase[0] + shift[0] * t, this._vmBase[1] + shift[1] * t, this._vmBase[2] + shift[2] * t])\n        }\n        this._viewmodelClearance(delta)\n        this._depthOfField(delta, this.ads)\n    }\n\n    /** A viewmodel animator's bool, sent down to the viewmodels when it changes. */\n    private _setViewParam(name: string, value: boolean) {\n        if (this._viewParams[name] === value) return\n        this._viewParams[name] = value\n        this._viewmodels?.dispatchDown('animator:SetParam', name, value)\n    }\n\n    /**\n     * Fire the one-shot `name` on a viewmodel's animator (its Actions layer state of that name) and return how long\n     * it lasts in seconds, or undefined when the weapon has no such clip.\n     */\n    private _playClip(view: any, name: string): number | undefined {\n        const info = view?.animator?.triggerInfo?.(name)\n        if (!view || !info) return undefined\n        view.dispatchDown('animator:SetTrigger', name)\n        return info.seconds > 0 ? info.seconds : info.clipLength\n    }\n\n    /**\n     * Where the viewmodel's muzzle is DRAWN: the viewmodel is drawn through the camera's viewmodel lens and at a share\n     * of its true distance, so its muzzle is not where its node is. The tracer starts there.\n     */\n    private _muzzleDrawn(): number[] | null {\n        const muzzle = this._view?.getChildByName('Muzzle')[0]\n        const camera: any = this.cameraRig()?.children.find(c => c.nodeType === 'camera')\n        if (!muzzle || !camera) return null\n        const w = muzzle.worldPosition, t = camera.worldTransform\n        const dx = w[0] - t[12], dy = w[1] - t[13], dz = w[2] - t[14]\n        const x = t[0] * dx + t[1] * dy + t[2] * dz, y = t[4] * dx + t[5] * dy + t[6] * dz, z = t[8] * dx + t[9] * dy + t[10] * dz\n        const k = this._vmDepth\n        const f = Math.tan(this.viewFov * Math.PI / 360) / Math.tan(this.viewmodelFov * Math.PI / 360)\n        const lx = x * f * k, ly = y * f * k, lz = z * k\n        return [t[0] * lx + t[4] * ly + t[8] * lz + t[12], t[1] * lx + t[5] * ly + t[9] * lz + t[13], t[2] * lx + t[6] * ly + t[10] * lz + t[14]]\n    }\n\n    /**\n     * Keep the viewmodel out of a wall: the share of its true distance it is drawn at, from the clearest of a few rays\n     * ahead of the camera. It shrinks toward the camera along every view ray, so it stays the same size on the screen.\n     */\n    private _viewmodelClearance(delta: number) {\n        const camera: any = this.cameraRig()?.children.find(c => c.nodeType === 'camera')\n        const physics: any = this.scene?.physics\n        if (!camera || !physics) return\n        camera.viewmodelFov = this.viewmodelFov\n        const p = camera.worldPosition, t = camera.worldTransform\n        const body = (this.collider as ColliderNode | null)?.body ?? null\n        let nearest = Infinity\n        // Camera-local +Z is forward, +X left, +Y up: a ray for the middle and four about it.\n        for (const [lx, ly] of [[0, 0], [0.22, 0], [-0.22, 0], [0, 0.18], [0, -0.22]]) {\n            const dir = [t[8] + t[0] * lx + t[4] * ly, t[9] + t[1] * lx + t[5] * ly, t[10] + t[2] * lx + t[6] * ly]\n            const len = Math.hypot(dir[0], dir[1], dir[2])\n            const reach = this.viewmodelReach + 0.1\n            const hit = physics.raycast([p[0], p[1], p[2]], [p[0] + dir[0] / len * reach, p[1] + dir[1] / len * reach, p[2] + dir[2] / len * reach], { ignore: body })\n            if (hit) nearest = Math.min(nearest, hit.distance)\n        }\n        const want = nearest === Infinity ? 1 : Math.max(0.3, Math.min(1, (nearest - 0.05) / this.viewmodelReach))\n        // In fast (never through a wall), out a little slower.\n        this._vmDepth = MathUtils.damp(this._vmDepth, want, want < this._vmDepth ? 40 : 9, delta)\n        camera.viewmodelDepth = this._vmDepth\n    }\n\n    /**\n     * Depth of field while aimed down the sights: the background softens, the focus where the crosshair points, the\n     * weapon (nearer than `dofNearCutoff`) sharp. Off the rest of the time, so it costs nothing; written only on a change.\n     */\n    private _depthOfField(delta: number, amount: number) {\n        if (amount < 0.01) {\n            if (this._dofOn) { Game.updateRenderSettings({ dofEnabled: false }); this._dofOn = false }\n            return\n        }\n        const camera: any = this.cameraRig()?.children.find(c => c.nodeType === 'camera')\n        const physics: any = this.scene?.physics\n        let focus = this.dofFarFocus\n        if (camera && physics) {\n            const p = camera.worldPosition, t = camera.worldTransform\n            const len = Math.hypot(t[8], t[9], t[10]) || 1\n            const hit = physics.raycast([p[0], p[1], p[2]], [p[0] + t[8] / len * focus, p[1] + t[9] / len * focus, p[2] + t[10] / len * focus],\n                { ignore: (this.collider as ColliderNode | null)?.body ?? null })\n            if (hit) focus = Math.max(1.5, hit.distance)\n        }\n        this._dofFocus = MathUtils.damp(this._dofFocus, focus, 8, delta)\n        const q = Math.round(amount * 20) / 20, f = Math.round(this._dofFocus * 10) / 10\n        const key = q + ':' + f\n        if (this._dofOn && key === this._dofKey) return\n        this._dofOn = true\n        this._dofKey = key\n        Game.updateRenderSettings({\n            dofEnabled: true, dofNearCutoff: this.dofNearCutoff, dofFocusDistance: f,\n            dofFocusRange: lerp(12, 2, q), dofAperture: lerp(16, this.dofAperture, q), dofMaxBlur: lerp(0.5, this.dofMaxBlur, q),\n        })\n    }\n\n    /**\n     * The HUD: the crosshair (shown with a weapon out, brighter aimed, its ticks as far out as the shot spreads; gone\n     * down the sights in first person), the ammunition (the magazine, the reserve, the weapon's name) and the reload.\n     */\n    private _hudToward(fp: boolean) {\n        if (!this._hud) {\n            const find = (n: string) => this.findNode(n) ?? null\n            this._hud = {\n                crosshair: find('Crosshair'), ammunition: find('Ammunition'), ammo: find('Ammo'), reserve: find('Reserve'),\n                name: find('Weapon Name'), reloading: find('Reloading'),\n                ticks: ['Top', 'Bottom', 'Left', 'Right'].map(n => find(`Crosshair ${n}`)),\n            }\n        }\n        const h = this._hud\n        const gun = this._gun\n        const out = Math.max(this.pistolWeight, this.rifleWeight, this.shotgunWeight, fp && gun ? 1 : 0)\n        if (h.crosshair) {\n            const aimed = fp && this.ads > 0.6 && !!gun?.aimClips\n            h.crosshair.opacity = aimed || (fp && this.sprinting) ? 0 : out * (fp ? 0.9 : 0.5 + 0.5 * this._aim)\n            // Pixels from the middle: the spread's angle at the screen's scale (1080 px over the field of view).\n            const fov = fp ? this.viewFov : 60\n            const perDegree = 540 / Math.tan(fov * Math.PI / 360) * Math.PI / 180\n            const gap = Math.round(4 + this.spreadNow * perDegree)\n            if (gap !== this._gap) {\n                this._gap = gap\n                const [top, bottom, left, right] = h.ticks\n                if (top) { top.offsetMin = [-1, -gap - 7]; top.offsetMax = [1, -gap] }\n                if (bottom) { bottom.offsetMin = [-1, gap]; bottom.offsetMax = [1, gap + 7] }\n                if (left) { left.offsetMin = [-gap - 7, -1]; left.offsetMax = [-gap, 1] }\n                if (right) { right.offsetMin = [gap, -1]; right.offsetMax = [gap + 7, 1] }\n            }\n        }\n        const shown = !!gun && this._carPhase === 'none'\n        if (h.ammunition && h.ammunition.visible !== shown) h.ammunition.visible = shown\n        if (shown) {\n            if (h.ammo) h.ammo.text = String(gun.ammo)\n            if (h.reserve) h.reserve.text = `/ ${gun.reserve}`\n            if (h.name) h.name.text = gun.displayName\n        }\n        const reloading = shown && this.reloading\n        if (h.reloading && h.reloading.visible !== reloading) h.reloading.visible = reloading\n    }\n\n    /**\n     * A shot from the weapon in the hands (SandboxGun's `weapon:Shot`, bubbling up from the grip): its recoil kicks\n     * the camera up and aside (less crouched and down the sights) and shakes it, and kicks the weapon in the hands. A\n     * shot fired some other way carries no recoil.\n     */\n    @eventListener('weapon:Shot')\n    private _shot(shot: { recoil?: { pitch: number, yaw: number, kick: number, shake?: number } | null }) {\n        const recoil = shot?.recoil\n        const rig = this.cameraRig()\n        if (!recoil || !rig) return\n        const pitch = recoil.pitch * (this.crouched ? 0.75 : 1) * (1 - this.ads * 0.35)\n        rig.pitch = rig.pitch - pitch\n        rig.yaw = rig.yaw + recoil.yaw\n        if (recoil.shake) rig.shake(recoil.shake)\n        this._recoilBack += pitch * this.recoilRecovery\n        this._kick += recoil.kick\n    }\n\n    /** The weapon in the hands changed (`weapon:Equipped`, from setting `weapon`): its model shown, the others hidden. */\n    @eventListener('weapon:Equipped')\n    private _equipped(weapon: number) {\n        this._showWeapon(weapon)\n    }\n\n    /** Show the weapon `weapon` (1 the pistol, 2 the rifle, 3 the shotgun) on the hand, and hide the others; 0 hides them all. */\n    private _showWeapon(weapon: number) {\n        this._weaponNodes?.forEach((n, k) => { if (n) n.visible = weapon === k + 1 })\n    }\n\n    /** An angle into -180..180 degrees. */\n    private _wrap(degrees: number): number {\n        return ((degrees + 180) % 360 + 360) % 360 - 180\n    }\n\n    // ----- the car ------------------------------------------------------------------------------------------------\n\n    /** The Mannequin's animator (the model under this Character). */\n    private get _animator(): Animator | null {\n        for (const c of this.children) {\n            const animator = (c as unknown as { animator?: Animator | null }).animator\n            if (animator) return animator\n        }\n        return null\n    }\n\n    /** The camera rig this character is seen through: its Controller's aim. */\n    public cameraRig(): CameraRigNode | null {\n        return (this._ownController ?? this.controller)?.aimRig ?? null\n    }\n\n    /**\n     * A car hands this character its seat: it gets in. It lets go of its Controller, takes its body out of the\n     * physics world (`physicsEnabled`) and moves under `seat`, keeping where it stands; fires `enterTrigger`, and\n     * steps onto `enterPoint` (a child of the seat: where getting in starts) while the clip reaches for the door.\n     * The clip's root motion then carries it into the seat. False, and nothing done, when it cannot: in the air,\n     * already in a car, or with an animator that has no such trigger.\n     */\n    public boardVehicle(seat: Node, enterPoint: Node): boolean {\n        const body = this.collider as ColliderNode | null\n        const animator = this._animator\n        const info = animator?.triggerInfo(this.enterTrigger)\n        if (this._carPhase !== 'none' || !body || !animator || !info || !this.isGrounded || this.isJumping) return false\n        this._ownController = this.controller\n        this._ownController?.release()\n        body.physicsEnabled = false\n        // Where the character faces is its own turn (the Character turns itself, not its Collider), and the step\n        // and the clip's root motion turn the Collider: fold the one into the other first, so they turn all of it.\n        const facing = this.worldForward\n        const heading = Math.atan2(facing[0], facing[2]) * 180 / Math.PI\n        body.setWorldYaw(heading)\n        body.updateTransforms(body.parent ? body.parent.worldTransform : null)\n        // The same heading in the world: no turn of its own left under the Collider.\n        this.setWorldYaw(heading)\n        this.updateTransforms(body.worldTransform)\n        body.reparent(seat)\n        this._seat = seat\n        // The step: from where it stands to where the clip starts, both in the seat's frame, eased in over the\n        // first part of the clip (time by distance).\n        this._alignFrom = this._localPose(body)\n        // Onto the start along the ground, at the height it stands at: the car may sit lower or higher on its springs\n        // than modelled (the backends' springs differ), and once seated the body eases onto the Seat itself.\n        const to: MathUtils.YawPose = this._localPose(enterPoint)\n        to[1] = this._alignFrom[1]\n        this._alignStep = MathUtils.yawPoseMul(MathUtils.yawPoseInvert(this._alignFrom), to)\n        const distance = Math.hypot(this._alignStep[0], this._alignStep[2])\n        this._alignTime = Math.min(this.alignMaxSeconds, this.alignSeconds * distance + 0.1)\n        this._alignT = 0\n        this._getIn()\n        this._enterSeconds = info.clipLength / Math.max(0.01, info.speed)\n        this._carTime = 0\n        this._carPhase = 'entering'\n        this.inVehicle = true\n        this.seated = false\n        return true\n    }\n\n    /** The car lets this character out: it gets out (`exitTrigger`), carried by the clip to the car's side. False when not seated. */\n    public leaveVehicle(): boolean {\n        const animator = this._animator\n        if (this._carPhase !== 'seated' || !animator || !animator.triggerInfo(this.exitTrigger)) return false\n        this._getOut()\n        this._carPhase = 'exiting'\n        this.seated = false\n        return true\n    }\n\n    /** The animator's getting-in clip: `enterTrigger`, sent down to the animator under this character. */\n    @animTrigger()\n    private _getIn() {\n        return this.enterTrigger\n    }\n\n    /** The animator's getting-out clip: `exitTrigger`, the same way. */\n    @animTrigger()\n    private _getOut() {\n        return this.exitTrigger\n    }\n\n    /**\n     * Getting out is over once the animator has left the exit trigger's states (back where it rests): it says so\n     * with `animation:TriggerEnded`, bubbling up from the model, and the character stands up.\n     */\n    @eventListener('animation:TriggerEnded')\n    private _triggerEnded(info: { trigger?: string, layer?: string | null }) {\n        if (this._carPhase !== 'exiting' || info?.trigger !== this.exitTrigger || info.layer) return\n        const body = this.collider as ColliderNode | null\n        if (body) this._standUp(body)\n    }\n\n    /** In a car: no walking (no intent asked for), nothing for the animator but the car's clips. */\n    private _ride(delta: number) {\n        const body = this.collider as ColliderNode | null\n        if (!body) return\n        this.hasMoveInput = false\n        this.running = false\n        this.sprinting = false\n        this.runTurn = 0\n        this.groundSpeed = 0\n        this.onStairs = false\n        this.stairs = 0\n        this.stairRate = 1\n        this.footPlacement = 0\n        this.facingMode = 'none'\n        const ease = delta > 0 ? 1 - Math.exp(-this.lookSpeed * delta) : 0\n        this.leanLeft = 0\n        this.leanRight = 0\n        this.leanForward = 0\n        this.lookWeight -= this.lookWeight * ease\n        // No weapon in a car: put away.\n        this._weaponsToward(delta, true, false, 0, 0)\n        this._carTime += delta\n\n        if (this._carPhase === 'entering') {\n            // The step onto the start, as a correction under the root motion that is already carrying the body:\n            // pose = start * step(t) * motion, applied by how much further along the step is this frame.\n            if (this._alignT < 1) {\n                const t0 = MathUtils.smoothstep(0, 1, this._alignT)\n                this._alignT = this._alignTime > 0 ? Math.min(1, this._alignT + delta / this._alignTime) : 1\n                const t1 = MathUtils.smoothstep(0, 1, this._alignT)\n                const none: MathUtils.YawPose = [0, 0, 0, 0]\n                const from = MathUtils.yawPoseLerp(none, this._alignStep, t0)\n                const to = MathUtils.yawPoseLerp(none, this._alignStep, t1)\n                const start = this._alignFrom\n                const shift = MathUtils.yawPoseMul(start, MathUtils.yawPoseMul(to, MathUtils.yawPoseMul(MathUtils.yawPoseInvert(from), MathUtils.yawPoseInvert(start))))\n                this._setLocalPose(body, MathUtils.yawPoseMul(shift, this._localPose(body)))\n            }\n            if (this._carTime >= this._enterSeconds) { this._carPhase = 'seated'; this.seated = true }\n            return\n        }\n        if (this._carPhase === 'seated') {\n            // On the seat: what the clip's travel left over (a few millimetres) eased out.\n            const k = this.settleSeconds > 0 && delta > 0 ? 1 - Math.exp(-3 * delta / this.settleSeconds) : 1\n            const pose = this._localPose(body)\n            if (Math.hypot(pose[0], pose[1], pose[2]) > 1e-4 || Math.abs(pose[3]) > 0.01)\n                this._setLocalPose(body, MathUtils.yawPoseLerp(pose, [0, 0, 0, 0], k))\n            return\n        }\n        // Getting out: the clip carries the body; `_triggerEnded` stands it up when the animator is done.\n    }\n\n    /** Out of the car: on its feet in the world again, upright, its body back in the physics world, its Controller back. */\n    private _standUp(body: ColliderNode) {\n        const scene = this.scene\n        if (!scene) return\n        const f = body.worldForward\n        const yaw = Math.atan2(f[0], f[2]) * 180 / Math.PI\n        body.reparent(scene.root)\n        body.setRotation([0, yaw, 0])\n        // On the ground under it: the clip stands it at the Seat's floor, which is the car's (on its springs).\n        const p = body.worldPosition, physics = scene.physics\n        const ground = physics?.raycast([p[0], p[1] + 1, p[2]], [p[0], p[1] - 1.5, p[2]], { collidingWith: body.body, groundOnly: true })\n        if (ground) body.setPosition([p[0], ground.point[1] + 0.02, p[2]])\n        body.updateTransforms(null)\n        body.physicsEnabled = true\n        this._ownController?.possess(this)\n        this._ownController = null\n        this._seat = null\n        this._carPhase = 'none'\n        this.inVehicle = false\n        this.seated = false\n    }\n\n    /** A node's upright pose in its parent's frame: `[x, y, z, yaw]`. */\n    private _localPose(node: Node): MathUtils.YawPose {\n        const p = node.position, q = node.quaternion\n        // +Z turned by the rotation: its heading is the yaw.\n        const fx = 2 * (q[0] * q[2] + q[3] * q[1]), fz = 1 - 2 * (q[0] * q[0] + q[1] * q[1])\n        return [p[0], p[1], p[2], Math.atan2(fx, fz) * 180 / Math.PI]\n    }\n\n    /** Places `node` at an upright pose in its parent's frame, its world transform brought up to date at once. */\n    private _setLocalPose(node: Node, pose: MathUtils.YawPose) {\n        node.setPosition([pose[0], pose[1], pose[2]])\n        node.setRotation([0, pose[3], 0])\n        node.updateTransforms(node.parent ? node.parent.worldTransform : null)\n    }\n}\n",
    "4d0ba2de75bb7541d081f691678c146d": "import { CameraRigNode, MathUtils, lerp } from 'cleo'\nimport type { Node } from 'cleo'\nimport { attribute } from 'cleo/decorators'\n\n/** What the camera reads from the character it belongs to (SandboxPlayer). */\ninterface Framed {\n    sprinting?: boolean\n    aiming?: boolean\n    crouched?: boolean\n    inVehicle?: boolean\n    /** The view the player asks for: first person, or third. */\n    firstPerson?: boolean\n    /** First person: the eye's height over the feet (m), and the field of view (degrees). */\n    eyeHeight?: number\n    viewFov?: number\n}\n\n/**\n * The Sandbox camera: one Camera Rig with its third-person framings, the aim's, and first person. It sits over the\n * shoulder, pulls out to third person while the character sprints, and moves in closer over the shoulder while it\n * aims a weapon; in first person it is at the character's eyes. Attach to the character's **Camera Rig**.\n *\n * The boom (arm length, the side offset of the camera, the height it orbits at) eases between the shoulder and third\n * person over `switchSeconds`, starting and ending gently either way. Where the camera looks stays the Controller's: it\n * turns the rig from the Look input, and this script never touches yaw or pitch. No action switches the third-person\n * framing; the character's sprint and aim do. They are read from the Character the rig belongs to (the one under the\n * Collider above it): its script's `sprinting` and `aiming`. The aim comes in quickly (`aimSeconds`), on top of\n * whichever of the two framings it is in. Crouched (the Character's `crouched`), it orbits `crouchDrop` lower.\n *\n * FIRST PERSON (the character's `firstPerson`, which the View action toggles): the boom folds in to the eyes over\n * `viewSeconds` (eased), to the character's `eyeHeight` over its feet, with no follow damping and no collision (the\n * camera is inside the capsule), a wider pitch and the character's own field of view (`viewFov`: Firing Line's 78\n * degrees, narrowing as it aims). Once the camera is in at the head, the character's body and the weapons in its\n * hands are drawn into the shadows alone (`Node.shadowOnly`): gone from the view they would fill, their shadow still\n * on the ground. In a car it is third person whatever was asked: the car's camera sees the driver.\n *\n * The framing distances are the character's (a taller one wants a higher pivot and a longer arm), so they are\n * public: each copy of the Player template can set its own. How the switch feels is the behavior's, so it is\n * private: set once, here.\n */\nexport default class SandboxCameraNode extends CameraRigNode {\n    /** Third person (while sprinting): how far behind the character the camera sits (m). */\n    @attribute('Framing', { min: 0.5, max: 12, step: 0.05 })\n    public thirdPersonArm: number = 3.4\n\n    /** Over the shoulder: how far behind (m). */\n    @attribute('Framing', { min: 0.5, max: 12, step: 0.05 })\n    public shoulderArm: number = 1.9\n\n    /** Over the shoulder: how far to the right of the character the camera sits (m). */\n    @attribute('Framing', { min: 0, max: 2, step: 0.05 })\n    public shoulderOffset: number = 0.5\n\n    /** Aiming: how far behind the character the camera sits (m), and how far to the right. */\n    @attribute('Framing', { min: 0.3, max: 12, step: 0.05 })\n    public aimArm: number = 1.25\n\n    @attribute('Framing', { min: 0, max: 2, step: 0.05 })\n    public aimShoulderOffset: number = 0.6\n\n    /** How high over the character's feet the camera orbits (m), and how much lower crouched. */\n    @attribute('Framing', { min: 0, max: 4, step: 0.05 })\n    public pivotHeight: number = 1.45\n\n    @attribute('Framing', { min: 0, max: 2, step: 0.05 })\n    public crouchDrop: number = 0.45\n\n    /** Seconds the switch between the two framings takes, either way. */\n    @attribute('Switch', { min: 0, max: 5, step: 0.05 })\n    private switchSeconds: number = 2\n\n    /** Seconds the aim's framing takes to come in, and to go out. */\n    @attribute('Switch', { min: 0, max: 2, step: 0.05 })\n    private aimSeconds: number = 0.25\n\n    /** Seconds the third-person framing stays after a sprint ends, so letting go for a moment does not swing it. */\n    @attribute('Switch', { min: 0, max: 2, step: 0.05 })\n    private sprintHold: number = 0.4\n\n    /** Seconds the switch to first person (and back) takes. */\n    @attribute('Switch', { min: 0, max: 2, step: 0.05 })\n    private viewSeconds: number = 0.3\n\n    /** Seconds the orbit takes to drop for a crouch, and to come back up. */\n    @attribute('Switch', { min: 0, max: 2, step: 0.05 })\n    private crouchSeconds: number = 0.25\n\n    /** The field of view in third person (degrees). */\n    @attribute('Switch', { min: 20, max: 120, step: 1 })\n    private thirdPersonFov: number = 60\n\n    /** First person: the pitch's reach, degrees up and down. */\n    @attribute('Switch', { min: 30, max: 89, step: 1 })\n    private firstPersonPitch: number = 85\n\n    private _sinceSprint: number = 1e9\n    /** Where the switch is: 0 over the shoulder, 1 third person. It moves at an even rate; the framing eases. */\n    private _mix: number = 0\n    /** Where the aim's framing is: 0 out, 1 in. */\n    private _aimMix: number = 0\n    private _aiming: boolean = false\n    /** Where the switch to first person is: 0 third person, 1 at the eyes (even rate; eased into `firstPersonMix`). */\n    private _fpMix: number = 0\n    private _crouchMix: number = 0\n    /** The rig as authored: what third person keeps. */\n    private _authored: { damping: number[], pitchMin: number, pitchMax: number, collision: boolean } | null = null\n\n    /** How far into first person the camera is: 0 third person, 1 at the eyes (eased). */\n    public firstPersonMix: number = 0\n\n    onStart() {\n        this._authored = {\n            damping: [this.followDamping[0], this.followDamping[1], this.followDamping[2]],\n            pitchMin: this.pitchMin, pitchMax: this.pitchMax, collision: this.collisionEnabled,\n        }\n        this.fovEnabled = true\n        // Start framed, not easing in from the rig's authored values.\n        this._frame(0, true)\n    }\n\n    onUpdate(delta: number) {\n        this._frame(delta, false)\n    }\n\n    /** Whether the camera is (heading) out to third person: while sprinting, and `sprintHold` after. */\n    get wide(): boolean {\n        return this._sinceSprint <= this.sprintHold\n    }\n\n    private get _character(): Framed | null {\n        return (this.collider?.character as unknown as Framed | null | undefined) ?? null\n    }\n\n    private _frame(delta: number, snap: boolean) {\n        const character = this._character\n        this._sinceSprint = character?.sprinting ? 0 : this._sinceSprint + delta\n        this._aiming = !!character?.aiming\n        const step = snap || this.switchSeconds <= 0 ? 1 : delta / this.switchSeconds\n        const target = this.wide ? 1 : 0\n        this._mix = target > this._mix ? Math.min(target, this._mix + step) : Math.max(target, this._mix - step)\n        // Eased in and out: the boom sets off and arrives gently. A switch reversed half way turns back from where\n        // it is.\n        const k = MathUtils.smoothstep(0, 1, this._mix)\n        const aimStep = snap || this.aimSeconds <= 0 ? 1 : delta / this.aimSeconds\n        this._aimMix = this._aiming ? Math.min(1, this._aimMix + aimStep) : Math.max(0, this._aimMix - aimStep)\n        const a = MathUtils.smoothstep(0, 1, this._aimMix)\n        const fpStep = snap || this.viewSeconds <= 0 ? 1 : delta / this.viewSeconds\n        const firstPerson = !!character?.firstPerson && !character?.inVehicle\n        this._fpMix = firstPerson ? Math.min(1, this._fpMix + fpStep) : Math.max(0, this._fpMix - fpStep)\n        const f = MathUtils.smoothstep(0, 1, this._fpMix)\n        this.firstPersonMix = f\n        const crouchStep = snap || this.crouchSeconds <= 0 ? 1 : delta / this.crouchSeconds\n        this._crouchMix = character?.crouched ? Math.min(1, this._crouchMix + crouchStep) : Math.max(0, this._crouchMix - crouchStep)\n        const c = MathUtils.smoothstep(0, 1, this._crouchMix)\n\n        // Third person, then folded in toward the eyes by `f`.\n        const arm = lerp(lerp(this.shoulderArm, this.thirdPersonArm, k), this.aimArm, a)\n        this.armLength = lerp(arm, 0, f)\n        // Socket +X is the rig's left: the right shoulder is negative.\n        this.socketOffset[0] = lerp(lerp(lerp(-this.shoulderOffset, 0, k), -this.aimShoulderOffset, a), 0, f)\n        this.socketOffset[1] = lerp(lerp(0.1, 0.15, k), 0, f)\n        this.socketOffset[2] = 0\n        const pivot = lerp(this.pivotHeight + 0.05, this.pivotHeight, k) - this.crouchDrop * c\n        this.followOffset[1] = lerp(pivot, character?.eyeHeight ?? pivot, f)\n        const authored = this._authored\n        if (authored) {\n            for (let i = 0; i < 3; i++) this.followDamping[i] = authored.damping[i] * (1 - f)\n            this.pitchMin = lerp(authored.pitchMin, -this.firstPersonPitch, f)\n            this.pitchMax = lerp(authored.pitchMax, this.firstPersonPitch, f)\n            this.collisionEnabled = authored.collision && f < 0.5\n        }\n        this.fov = lerp(this.thirdPersonFov, character?.viewFov ?? this.thirdPersonFov, f)\n\n        // At the eyes, the body and the weapons it holds are drawn into the shadows only.\n        const inside = f > 0.6\n        const body = this.follow as Node | null\n        if (body && body.shadowOnly !== inside) body.shadowOnly = inside\n        const weapons = (this.collider?.character as unknown as Node | null)?.getChildByName('Weapons')[0]\n        if (weapons && weapons.shadowOnly !== inside) weapons.shadowOnly = inside\n    }\n}\n",
    "ec74228fde16d9f04b7d07c41c43da50": "import { Logger, MathUtils, Node } from 'cleo'\nimport type { LayerName, TemplateName } from 'cleo'\nimport { attribute, eventDispatch } from 'cleo/decorators'\n\n/** What one shot was, as the gun tells it (`weapon:Shot`). */\nexport interface SandboxShot {\n    gun: Node\n    /** What the first pellet hit (the only one, but for a shotgun), or null: nothing within `range`. */\n    hit: { point: number[], node: Node | null } | null\n    /** Every pellet's hit (a shotgun fires `pellets` of them); null where a pellet hit nothing. */\n    hits: ({ point: number[], node: Node | null } | null)[]\n    /** The kick a pull of the trigger gives (camera pitch up and yaw, degrees, the weapon's own, the camera's shake); null for a shot fired directly. */\n    recoil: { pitch: number, yaw: number, kick: number, shake: number } | null\n}\n\n/** Where a shot is seen from: the third person's weapon in the hands, or the first person's viewmodel. */\nexport interface SandboxShotView {\n    /** Fired in first person: the camera's ray alone, and no flash or sound of the gun's own (the viewmodel's clip has them). */\n    firstPerson: boolean\n    /** Where the tracer starts in first person: the viewmodel's muzzle where it is drawn. */\n    muzzle?: ArrayLike<number> | null\n}\n\n/**\n * A Sandbox gun: the weapon in the hands, in either view. Attach to a weapon's holder (the `Pistol Grip`, `Rifle Grip`\n * and `Shotgun Grip` nodes on the Mannequin's hand), whose child `Muzzle` is the end of its bore. Its numbers are the\n * weapon's (Firing Line's pistol, AK-47 and SAPS-12), set on each holder in the Player template. The character\n * holding it (SandboxPlayer) calls {@link pull} every frame with the trigger and where the crosshair looks; the gun\n * decides when a shot goes, spends a round from its magazine, and returns the recoil for the holder to apply. It\n * keeps its own magazine and reserve (`ammo`, `reserve`), so a weapon put away and taken out again is as it was left;\n * {@link reload} fills the magazine from the reserve. Out of the reserve, it is dry until the scene starts again.\n *\n * A SHOT is a raycast per pellet (a pistol and a rifle fire one; the shotgun `pellets`), each its own way inside the\n * spread's cone. In third person a pellet is two raycasts: from the camera through the crosshair, up to `range`\n * (what the player aims at), then from the muzzle to that point (what the bullet meets on its way: a corner the\n * camera sees past but the gun does not). In first person the camera's alone, as Firing Line fires. Neither meets the\n * shooter's own body, the trigger zones or the layers named in `passThroughLayers` (the stairs' ramps: there to be\n * walked on, not seen).\n *\n * A HIT on a dynamic body pushes it: the shot's `impulse` (shared by its pellets) along the shot at the point it hit\n * (so a crate hit high tips, a ball spins), no more than `maxPushSpeed` of speed at once. Every hit leaves sparks and\n * dust (`impactTemplate`) and a hole (`holeTemplate`), the hole moving with what it is on; the shot draws a tracer\n * (`tracerTemplate`). In third person the gun flashes at its muzzle (`flashTemplate`) and plays its shot (`shotSound`,\n * a cue in the character's `Sounds` group); in first person the viewmodel's fire clip does both. A template the scene\n * does not have is skipped, with a warning once.\n *\n * SPREAD is Firing Line's: a cone round the crosshair, from `hipSpread` to `aimSpread` as the weapon aims, half again\n * moving (2.2 times at a sprint), less crouched, much more in the air, and wider the longer it fires (bloom, up to 1.6\n * times the hip spread, settling at 5 degrees a second). The holder reads {@link spread} for its crosshair.\n *\n * EVERY SHOT is told as the event `weapon:Shot` (a {@link SandboxShot}), dispatched at the gun: it bubbles up to the\n * character holding it, whose `@eventListener('weapon:Shot')` applies the recoil, and then reaches anything listening\n * with `@onEvent('weapon:Shot')` anywhere (a hit marker, a sound, a score).\n */\nexport default class SandboxGunNode extends Node {\n    /** The weapon's name, on the HUD. */\n    @attribute('Weapon')\n    public displayName: string = 'Pistol'\n\n    /** Holding the trigger keeps firing (a rifle); a pistol or the shotgun fires once per pull. */\n    @attribute('Firing')\n    public auto: boolean = false\n\n    @attribute('Firing', { min: 30, max: 1500, step: 1 })\n    public roundsPerMinute: number = 380\n\n    /** Pellets a shot fires, each its own way inside the spread: 1, but for a shotgun. */\n    @attribute('Firing', { min: 1, max: 24, step: 1 })\n    public pellets: number = 1\n\n    /** How far a shot reaches, m. */\n    @attribute('Firing', { min: 5, max: 1000, step: 5 })\n    public range: number = 140\n\n    /**\n     * The push a shot gives a dynamic body, newton-seconds (shared by its pellets): far more than a real bullet's (a\n     * rifle's carries about 4), so a shot crate shoves. No body is sped up by more than `maxPushSpeed` by one hit, so a\n     * ball is not shot away.\n     */\n    @attribute('Firing', { min: 0, max: 500, step: 0.5 })\n    public impulse: number = 14\n\n    @attribute('Firing', { min: 0, max: 50, step: 0.25 })\n    public maxPushSpeed: number = 2.5\n\n    /** Damage a pellet deals at close range (nothing in the Sandbox takes it yet: kept for game modes). */\n    @attribute('Firing', { min: 0, max: 500, step: 1 })\n    public damage: number = 26\n\n    /**\n     * A pull that comes while the gun cannot fire yet (still coming up from the hip, or between two shots) fires as soon\n     * as it can, if that is within this many seconds.\n     */\n    @attribute('Firing', { min: 0, max: 1, step: 0.05 })\n    public pullBuffer: number = 0.35\n\n    /** Rounds a magazine holds, and the rounds carried besides it. */\n    @attribute('Ammunition', { min: 1, max: 200, step: 1 })\n    public magazine: number = 12\n\n    @attribute('Ammunition', { min: 0, max: 2000, step: 1 })\n    public reserveRounds: number = 84\n\n    /** Spread, degrees from the crosshair at most: from the hip, and aimed. */\n    @attribute('Spread', { min: 0, max: 20, step: 0.05 })\n    public hipSpread: number = 1.6\n\n    @attribute('Spread', { min: 0, max: 20, step: 0.05 })\n    public aimSpread: number = 0.25\n\n    /** The camera's kick per shot, degrees: up, and up to this either way; and how hard the camera shakes (0..1). */\n    @attribute('Recoil', { min: 0, max: 20, step: 0.05 })\n    public recoilPitch: number = 1.5\n\n    @attribute('Recoil', { min: 0, max: 10, step: 0.05 })\n    public recoilYaw: number = 0.45\n\n    @attribute('Recoil', { min: 0, max: 1, step: 0.01 })\n    public shake: number = 0.04\n\n    /** The weapon's own kick in the hands per shot, degrees up (third person: the aim settles it back). */\n    @attribute('Recoil', { min: 0, max: 30, step: 0.5 })\n    public kick: number = 7\n\n    /** Seconds a reload and the weapon coming into the hands take where no clip says (third person). */\n    @attribute('Timing', { min: 0.1, max: 10, step: 0.05 })\n    public reloadSeconds: number = 2.2\n\n    @attribute('Timing', { min: 0.1, max: 5, step: 0.05 })\n    public equipSeconds: number = 1.2\n\n    /** First person, aimed: the field of view (degrees), the share of the walk it moves at, and whether its viewmodel has aim clips. */\n    @attribute('First Person', { min: 10, max: 120, step: 1 })\n    public aimFov: number = 62\n\n    @attribute('First Person', { min: 0.1, max: 1, step: 0.05 })\n    public aimMove: number = 0.7\n\n    @attribute('First Person')\n    public aimClips: boolean = true\n\n    /** First person, aimed without aim clips: how far the viewmodel comes in to the sights (m: left, up, forward). */\n    @attribute('First Person')\n    public aimOffset: number[] = [0, 0.012, 0]\n\n    /** Collision layers a shot passes through, by name. */\n    @attribute('Hits')\n    public passThroughLayers: LayerName[] = ['Stair Ramp']\n\n    /** Bullet holes this gun keeps; the oldest goes when there are more. */\n    @attribute('Hits', { min: 0, max: 500, step: 1 })\n    public maxHoles: number = 60\n\n    @attribute('Effects')\n    public flashTemplate: TemplateName = 'Muzzle Flash' as TemplateName\n\n    @attribute('Effects')\n    public impactTemplate: TemplateName = 'Bullet Impact' as TemplateName\n\n    @attribute('Effects')\n    public holeTemplate: TemplateName = 'Bullet Hole' as TemplateName\n\n    @attribute('Effects')\n    public tracerTemplate: TemplateName = 'Tracer' as TemplateName\n\n    /** The shot's cue in the holder's `Sounds` group (third person; in first person the fire clip plays it). */\n    @attribute('Effects')\n    public shotSound: string = 'ShotPistol'\n\n    /** Rounds in the magazine, and in the reserve. */\n    public ammo: number = 12\n    public reserve: number = 84\n    /** Shots fired, ever, and what the last one hit (null: nothing within `range`). */\n    public shots: number = 0\n    public lastHit: { point: number[], node: Node | null } | null = null\n    /** The last pull found the magazine empty. */\n    public dry: boolean = false\n\n    /** Seconds to the next shot the rate allows (below 0: the shot is late by that much, and the next comes as early). */\n    private _cooldown: number = 0\n    private _held: boolean = false\n    /** Seconds a pull that could not fire yet still waits to. */\n    private _queued: number = 0\n    private _bloom: number = 0\n    private _mask: number | null = null\n    private _holes: Node[] = []\n    private _missing: Set<string> = new Set()\n    private readonly _dir: number[] = [0, 0, 0]\n\n    onStart() {\n        this.ammo = this.magazine\n        this.reserve = this.reserveRounds\n    }\n\n    onUpdate(delta: number) {\n        this._cooldown -= delta\n        this._queued = Math.max(0, this._queued - delta)\n        this._bloom = Math.max(0, this._bloom - 5 * delta)\n    }\n\n    /**\n     * The spread now, degrees: `aim` 0 from the hip to 1 aimed, and whether the holder is moving, sprinting,\n     * crouching and on the ground.\n     */\n    public spread(aim: number, moving: boolean, sprinting = false, crouched = false, grounded = true): number {\n        const a = Math.max(0, Math.min(1, aim))\n        const base = this.hipSpread + (this.aimSpread - this.hipSpread) * a\n        return base * (moving ? (sprinting ? 2.2 : 1.5) : 1) * (crouched ? 0.7 : 1) * (grounded ? 1 : 2.5) + this._bloom * (1 - a * 0.6)\n    }\n\n    /** Whether a reload would put anything in the magazine. */\n    public get canReload(): boolean {\n        return this.ammo < this.magazine && this.reserve > 0\n    }\n\n    /** Fill the magazine from the reserve; returns the rounds moved. */\n    public reload(): number {\n        const take = Math.min(this.magazine - this.ammo, this.reserve)\n        this.ammo += take\n        this.reserve -= take\n        return take\n    }\n\n    /**\n     * The trigger, every frame: `held` whether it is pulled, `ready` whether the weapon is up to fire, `eye` and\n     * `look` the camera's position and the way the crosshair looks (unit), `spread` the cone (degrees), `shooter` the\n     * body the shots never meet, `view` where it is seen from. Fires when the trigger asks, the gun is ready and the\n     * magazine holds a round; returns the recoil of the shot, or null when it did not fire (`dry` says whether that\n     * was an empty magazine).\n     */\n    public pull(held: boolean, ready: boolean, eye: ArrayLike<number>, look: ArrayLike<number>, spread: number, shooter: unknown, view: SandboxShotView)\n        : SandboxShot['recoil'] {\n        // A pull (the trigger going down) waits `pullBuffer` for the gun to be able to fire; an automatic fires while held.\n        const pulled = held && !this._held\n        if (pulled) this._queued = this.pullBuffer\n        this._held = held\n        this.dry = false\n        const wants = this.auto ? held : this._queued > 0\n        if (!wants || !ready) { this._cooldown = Math.max(0, this._cooldown); return null }\n        if (this._cooldown > 0) return null\n        if (this.ammo <= 0) { this.dry = pulled || this.auto; this._queued = 0; return null }\n        // The rate kept on average, whatever the frame rate: a shot late by part of a frame brings the next one forward.\n        const interval = 60 / Math.max(1, this.roundsPerMinute)\n        this._cooldown = Math.max(this._cooldown, -interval) + interval\n        this._queued = 0\n        this.ammo--\n        const recoil = { pitch: this.recoilPitch, yaw: (Math.random() * 2 - 1) * this.recoilYaw, kick: this.kick, shake: this.shake }\n        this.fire(eye, look, spread, shooter, recoil, view)\n        this._bloom = Math.min(this.hipSpread * 1.6, this._bloom + this.hipSpread * 0.12)\n        return recoil\n    }\n\n    /**\n     * One shot from the camera at `eye` along `look`, `spread` degrees round it at most, passing `shooter`'s body:\n     * a raycast (or two) per pellet, the push, the effects, and the `weapon:Shot` event (with `recoil`, when a pull\n     * fired it). Spends no round. Returns what the first pellet hit, or null.\n     */\n    public fire(eye: ArrayLike<number>, look: ArrayLike<number>, spread: number, shooter?: unknown,\n        recoil: SandboxShot['recoil'] = null, view: SandboxShotView = { firstPerson: false }): { point: number[], node: Node | null } | null {\n        const hits = this._shoot(eye, look, spread, shooter, view)\n        this._told({ gun: this, hit: hits[0] ?? null, hits, recoil })\n        return hits[0] ?? null\n    }\n\n    /** Tell the shot: what this returns is the `weapon:Shot` event, dispatched here and bubbling to the holder. */\n    @eventDispatch('weapon:Shot')\n    private _told(shot: SandboxShot): SandboxShot {\n        return shot\n    }\n\n    /** The shot itself: its pellets' raycasts, the pushes and the effects. */\n    private _shoot(eye: ArrayLike<number>, look: ArrayLike<number>, spread: number, shooter: unknown, view: SandboxShotView) {\n        const physics = this.scene?.physics as any\n        this.shots++\n        const muzzleNode = this.getChildByName('Muzzle')[0] ?? this\n        muzzleNode.updateTransforms(muzzleNode.parent ? muzzleNode.parent.worldTransform : null)\n        const m = view.firstPerson && view.muzzle ? view.muzzle : muzzleNode.worldPosition\n        const muzzle = [m[0], m[1], m[2]]\n        if (!view.firstPerson) {\n            const f = muzzleNode.worldForward\n            this._spawn(this.flashTemplate, muzzle, eulerAlong([f[0], f[1], f[2]]))\n            this._playSound()\n        }\n        this.lastHit = null\n        const hits: ({ point: number[], node: Node | null } | null)[] = []\n        if (!physics) return hits\n        const options = { ignore: shooter ?? null, layerMask: this._layerMask(physics) }\n        const pellets = Math.max(1, Math.round(this.pellets))\n        const push = this.impulse / pellets\n        for (let k = 0; k < pellets; k++) {\n            const dir = MathUtils.randomInCone(this._dir, look, spread) as number[]\n            // What the crosshair looks at...\n            const far = [eye[0] + dir[0] * this.range, eye[1] + dir[1] * this.range, eye[2] + dir[2] * this.range]\n            const seen = physics.raycast([eye[0], eye[1], eye[2]], far, options)\n            let hit = seen, way = [dir[0], dir[1], dir[2]]\n            if (!view.firstPerson) {\n                // ...and, in third person, what the bullet meets on its way there from the muzzle (a little past it,\n                // so it meets the surface).\n                const target = seen ? seen.point : far\n                const toTarget = [target[0] - muzzle[0], target[1] - muzzle[1], target[2] - muzzle[2]]\n                const length = Math.hypot(toTarget[0], toTarget[1], toTarget[2])\n                if (length < 1e-3) { hits.push(null); continue }\n                way = [toTarget[0] / length, toTarget[1] / length, toTarget[2] / length]\n                const end = [muzzle[0] + way[0] * (length + 0.05), muzzle[1] + way[1] * (length + 0.05), muzzle[2] + way[2] * (length + 0.05)]\n                hit = physics.raycast(muzzle, end, options)\n                // One tracer a shot: the first pellet's.\n                if (k === 0) this._tracer(muzzle, hit ? hit.point : target)\n            } else if (k === 0) this._tracer(muzzle, seen ? seen.point : far)\n            const record = hit ? { point: [hit.point[0], hit.point[1], hit.point[2]], node: hit.node ?? null } : null\n            hits.push(record)\n            if (k === 0) this.lastHit = record\n            if (!hit) continue\n            this._push(hit, way, push)\n            this._impact(hit)\n        }\n        return hits\n    }\n\n    /** Every layer but `passThroughLayers`, looked up by name once. */\n    private _layerMask(physics: any): number {\n        if (this._mask === null) {\n            let mask = -1\n            for (const name of this.passThroughLayers ?? []) if (name) mask &= ~(physics.layer?.(name) ?? 0)\n            this._mask = mask\n        }\n        return this._mask\n    }\n\n    /** A dynamic body hit is pushed along the shot, at the point hit (measured from its centre). */\n    private _push(hit: any, way: number[], impulse: number): void {\n        const body = hit.body\n        if (!body || !body.isDynamic || impulse <= 0) return\n        const origin = body.owner?.worldPosition ?? hit.point\n        const push = Math.min(impulse, this.maxPushSpeed * Math.max(0, body.mass ?? 0))\n        if (push <= 0) return\n        body.wakeUp?.()\n        body.impulse([way[0] * push, way[1] * push, way[2] * push],\n            [hit.point[0] - origin[0], hit.point[1] - origin[1], hit.point[2] - origin[2]])\n    }\n\n    /** Sparks and dust off the surface, and a hole in it: one that moves with what it is on. */\n    private _impact(hit: any): void {\n        const n = hit.normal\n        const at = [hit.point[0] + n[0] * 0.01, hit.point[1] + n[1] * 0.01, hit.point[2] + n[2] * 0.01]\n        const rotation = eulerOntoNormal(n)\n        this._spawn(this.impactTemplate, at, rotation)\n        const hole = this._spawn(this.holeTemplate, at, [rotation[0], rotation[1], Math.random() * 360])\n        if (!hole) return\n        // On a body that moves, the hole goes with it.\n        if (hit.node && hit.body?.isDynamic) hole.reparent(hit.node)\n        this._holes.push(hole)\n        while (this._holes.length > this.maxHoles) {\n            const old = this._holes.shift()!\n            if (old.scene) old.remove({ immediate: true })\n        }\n    }\n\n    /** A streak from the muzzle to where the shot ended (none for a shot too short to see one). */\n    private _tracer(from: number[], to: number[]): void {\n        const d = [to[0] - from[0], to[1] - from[1], to[2] - from[2]]\n        const length = Math.hypot(d[0], d[1], d[2])\n        if (length < 2) return\n        const node: any = this._spawn(this.tracerTemplate, from, eulerAlong(d))\n        if (node) node.tracerLength = length\n    }\n\n    /** The shot's cue, from the nearest `Sounds` group above the gun (the character's). */\n    private _playSound(): void {\n        if (!this.shotSound) return\n        for (let n: Node | null = this.parent; n; n = n.parent) {\n            const group = n.getChildByName('Sounds')[0]\n            if (!group) continue\n            const cue = group.getChildByName(this.shotSound)[0] as any\n            cue?.play?.()\n            return\n        }\n    }\n\n    /** Spawn an effect template, or nothing (and a warning, once) when the scene has none of that name. */\n    private _spawn(template: string, position: number[], rotation: number[]): Node | null {\n        if (!template || this._missing.has(template)) return null\n        const node = (this.scene as any)?.instantiate(template, { position, rotation }) ?? null\n        if (!node) {\n            this._missing.ad