                          {
                            "id": "4b9a49bd58f5652329b918c29d9190a7",
                            "name": "Muzzle",
                            "type": "node",
                            "position": [0, 0.09929999709129333, 0.23499999940395355],
                            "rotation": [0, 0, 0],
                            "scale": [1, 1, 1],
