                        "spawnOnStart": true
                      },
                      {
                        "id": "8c3dd48e94fe7f504437fbdf21c1f5e6",
                        "name": "Muzzle",
                        "type": "node",
                        "position": [0, 0.09929999709129333, 0.23499999940395355],
                        "rotation": [0, 0, 0],
                        "scale": [1, 1, 1],
                        "children": [],
                        "variables": {},
                        "spawnOnStart": true
