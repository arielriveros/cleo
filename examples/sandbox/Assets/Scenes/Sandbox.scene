                          {
                            "id": "9ae7b44224c35587ea1f7eda1cf60a0e",
                            "name": "Muzzle",
                            "type": "node",
                            "position": [0.013829999603331089, 0.08686000108718872, 0.5827000141143799],
                            "rotation": [0, 0, 0],
                            "scale": [1, 1, 1],
