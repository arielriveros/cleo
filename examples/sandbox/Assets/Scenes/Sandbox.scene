                          {
                            "id": "60c992485476a522c78457b93b72ac8d",
                            "name": "Muzzle",
                            "type": "node",
                            "position": [0.013829999603331089, 0.08686000108718872, 0.5827000141143799],
                            "rotation": [0, 0, 0],
                            "scale": [1, 1, 1],
