                            "t": 299,
                            "v": "The snow melts"
                          },
                          {
                            "t": 329,
                            "v": "Clear again"
                          },
                          {
                            "t": 358,
                            "v": "IV  ·  Water  ·  screen-space reflections"
                          }
                        ]
