                          {
                            "t": 9,
                            "v": "I  ·  The Valley"
                          },
                          {
                            "t": 31,
                            "v": "Foliage density  ·  100%  →  10%  →  100%"
                          },
                          {
                            "t": 42,
                            "v": "Draw distance  ·  trees 450 m  →  70 m  →  450 m"
                          },
                          {
                            "t": 54,
                            "v": "II  ·  Light"
                          },
                          {
                            "t": 64,
                            "v": "Dynamic global illumination: the sunlight through the door bounces round the room"
                          },
                          {
                            "t": 104,
                            "v": "At night, candlelight: the GI carries it round the room, and the eye adapts to it"
                          },
                          {
                            "t": 118,
                            "v": "III  ·  Weather  ·  time ×2"
                          },
                          {
                            "t": 139,
                            "v": "Clouds gather"
                          },
                          {
                            "t": 179,
                            "v": "First rain"
                          },
                          {
                            "t": 193,
                            "v": "Wet ground and puddles: screen-space reflections, raindrop ripples"
                          },
                          {
                            "t": 210,
                            "v": "Storm"
                          },
                          {
                            "t": 260,
                            "v": "Rain turns to snow"
                          },
