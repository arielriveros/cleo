              "sizing": "fixed",
              "padding": [0, 0, 0, 0],
              "borderRadius": 0,
              "borderWidth": 0,
              "borderColor": [0, 0, 0, 1],
              "space": "screen",
              "referenceResolution": [1920, 1080],
              "scaleMode": "scaleWithScreen",
              "matchWidthOrHeight": 0.5,
              "referenceDpr": 1,
              "uiTargetId": null,
