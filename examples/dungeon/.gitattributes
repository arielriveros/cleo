# Cleo example: text stays LF everywhere (scripts are hashed, and a CRLF checkout would change them).
# The binary data is not in git (see .gitignore and data.lock.json).
* text=auto eol=lf
Blobs/** -text
Baked/** -text
Derived/** -text
*.[pP][nN][gG] -text
*.[jJ][pP][gG] -text
*.[jJ][pP][eE][gG] -text
*.[wW][eE][bB][pP] -text
*.[gG][iI][fF] -text
*.[bB][mM][pP] -text
*.[tT][gG][aA] -text
*.[tT][iI][fF][fF] -text
*.[kK][tT][xX]2 -text
*.[hH][dD][rR] -text
*.[eE][xX][rR] -text
*.[aA][vV][iI][fF] -text
