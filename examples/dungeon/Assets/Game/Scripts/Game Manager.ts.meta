        },
        "access": "public",
        "default": "Blood Spray",
        "hidden": false,
        "attribute": {
          "group": "Blood",
          "tooltip": "The blood thrown off a wound, spawned where the hit struck and scaled with it (particles in the kit; the Valley's is a lit flipbook of an FX Creator liquid simulation). Empty: no spray, the decal alone."
        }
      },
