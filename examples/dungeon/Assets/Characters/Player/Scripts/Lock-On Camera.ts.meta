    "name": "Lock-On Camera",
    "baseType": "cameraRig",
    "source": {
      "$file": 1
    },
    "kind": "class",
    "variables": [
      {
        "name": "lockRange",
        "type": {
          "kind": "number"
        },
        "access": "public",
        "default": 20,
        "hidden": false,
        "attribute": {}
      },
      {
        "name": "breakRange",
        "type": {
          "kind": "number"
        },
        "access": "public",
        "default": 26,
        "hidden": false,
        "attribute": {}
      },
      {
        "name": "losBreakSeconds",
        "type": {
          "kind": "number"
        },
        "access": "public",
        "default": 1.5,
        "hidden": false,
        "attribute": {
          "tooltip": "Seconds the target may stay hidden behind geometry before the lock lets go."
        }
      },
      {
        "name": "switchCooldown",
        "type": {
          "kind": "number"
        },
        "access": "public",
        "default": 0.35,
        "hidden": false,
        "attribute": {
          "tooltip": "Seconds between two target switches, so one flick switches once."
        }
      },
      {
        "name": "stickFlick",
        "type": {
          "kind": "number"
        },
        "access": "public",
        "default": 2.6,
        "hidden": false,
        "attribute": {
          "tooltip": "Right-stick deflection (scaled ×4 in the map) that counts as a flick."
        }
      },
      {
        "name": "mouseFlickPerSecond",
        "type": {
          "kind": "number"
        },
        "access": "public",
        "default": 2700,
        "hidden": false,
        "attribute": {
          "tooltip": "Mouse speed, in pixels per SECOND, that counts as a flick. A per-frame pixel threshold made switching targets harder the higher the frame rate, since the same flick is spread over more frames."
        }
      },
      {
        "name": "lockedPitchMin",
        "type": {
          "kind": "number"
        },
        "access": "public",
        "default": -25,
        "hidden": false,
        "attribute": {
          "tooltip": "Pitch limits while locked (positive looks down). Keeps a tall boss from flipping the camera."
        }
      },
      {
        "name": "lockedPitchMax",
        "type": {
          "kind": "number"
        },
        "access": "public",
        "default": 35,
        "hidden": false,
        "attribute": {}
      },
      {
        "name": "reticleName",
        "type": {
          "kind": "string"
        },
        "access": "public",
        "default": "LockReticle",
        "hidden": false,
        "attribute": {}
      },
      {
        "name": "retargetRange",
        "type": {
          "kind": "number"
        },
        "access": "public",
        "default": 10,
        "hidden": false,
        "attribute": {
          "tooltip": "When the target dies, the lock jumps to another enemy only if one is this close."
        }
      },
      {
        "name": "lockedArmLength",
        "type": {
          "kind": "number"
        },
        "access": "public",
        "default": 2.3,
        "hidden": false,
        "attribute": {
          "tooltip": "Boom length while locked: closer than the free camera, for a tighter view of the fight."
        }
      },
      {
        "name": "lockedSocketOffset",
        "type": {
          "kind": "vector",
          "size": 3
        },
        "access": "public",
        "default": [-0.6, 0.15, 0],
        "hidden": false,
        "attribute": {
          "tooltip": "Pivot offset while locked (rig space: +X is the rig's LEFT, +Y up) — negative X, so the camera sits over the RIGHT shoulder and the target is framed past it."
        }
      },
      {
        "name": "lockBlendSeconds",
        "type": {
          "kind": "number"
        },
        "access": "public",
        "default": 0.3,
        "hidden": false,
        "attribute": {
          "tooltip": "Seconds the camera takes to move in on a lock, and back out on release."
        }
      },
