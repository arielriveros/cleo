{
  "name": "cleo",
  "version": "1.0.0",
  "description": "WebGL2 Game Engine",
  "main": "cleo.js",
  "scripts": {
    "watch": "webpack --watch",
    "build": "webpack --mode=production --node-env=production",
    "editor": "cd editor && npm run start",
    "build:dev": "webpack --mode=development",
    "build:player": "cd editor && npm run build:player",
    "editor:install": "cd editor && npm ci",
    "editor:dev": "concurrently \"npm run watch\" \"npm run editor\"",
    "editor:build": "cd editor && npm run build",
    "desktop:install": "cd desktop && npm install",
    "desktop:dev": "concurrently \"npm run watch\" \"npm run editor\" \"cd desktop && npm run dev\"",
    "desktop:build": "npm run build && npm run build:editor && npm run build:player && cd desktop && npm run dist"
  },
  "author": "Ariel Riveros",
  "license": "ISC",
  "devDependencies": {
    "@types/uuid": "^9.0.7",
    "@types/webgl2": "0.0.10",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^14.0.0",
    "file-loader": "^6.2.0",
    "ts-loader": "^9.5.1",
    "ts-shader-loader": "^2.0.2",
    "typescript": "^5.3.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "gl-matrix": "^3.4.3",
    "uuid": "^14.0.1"
  }
}
