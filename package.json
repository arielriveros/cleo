{
  "name": "cleo",
  "version": "1.2.4",
  "description": "WebGL2 Game Engine",
  "types": "dist/cleo.d.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "jsdoc:gaps": "node tools/jsdoc-gaps.mjs",
    "watch:types": "node tools/watchTypes.mjs",
    "build": "node tools/buildDist.mjs",
    "build:dev": "npm run build",
    "build:types": "npm run build",
    "editor": "cd applications/editor && npm run start",
    "editor:serve": "cd applications/editor && npm run dev",
    "build:player": "cd applications/editor && npm run build:player",
    "build:player:only": "cd applications/editor && npm run build:player:only",
    "editor:install": "cd applications && npm ci",
    "editor:dev": "node tools/ensurePlayer.mjs && concurrently \"npm run watch:types\" \"npm run editor\"",
    "editor:build": "npm run build:player && cd applications/editor && npm run build",
    "desktop:install": "cd applications/app-kit/desktop && npm install",
    "desktop:dev": "node tools/ensurePlayer.mjs && concurrently \"npm run watch:types\" \"npm run editor:serve\" \"npm run creator:serve\" \"cd applications/app-kit/desktop && npm run dev\"",
    "desktop:build": "npm run build && npm run editor:build && cd applications/app-kit/desktop && npm run dist",
    "naga:build": "node tools/naga-wasm/build.mjs",
    "apps:install": "cd applications && npm ci",
    "creator": "cd applications/creator && npm run start",
    "creator:serve": "cd applications/creator && npm run dev",
    "creator:dev": "concurrently \"npm run watch:types\" \"npm run creator\"",
    "creator:build": "cd applications/creator && npm run build",
    "dev:all": "node tools/ensurePlayer.mjs && concurrently \"npm run watch:types\" \"npm run editor\" \"npm run creator:serve\""
  },
  "author": "Ariel Riveros",
  "license": "ISC",
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/uuid": "^9.0.7",
    "@types/webgl2": "0.0.10",
    "@types/yuka": "^0.7.4",
    "@vitest/coverage-istanbul": "^3.2.7",
    "@webgpu/types": "^0.1.72",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "gl-matrix": "3.4.4",
    "howler": "^2.2.4",
    "meshoptimizer": "^1.3.0",
    "sucrase": "^3.35.1",
    "uuid": "^14.0.1",
    "yuka": "^0.7.8"
  },
  "engines": {
    "node": ">=22"
  }
}
