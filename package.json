{
  "name": "cleo",
  "version": "0.156.27",
  "description": "WebGL2 Game Engine",
  "main": "cleo.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "jsdoc:gaps": "node tools/jsdoc-gaps.mjs",
    "watch": "webpack --watch",
    "build": "webpack --mode=production --node-env=production && npm run build:types",
    "build:dev": "webpack --mode=development && npm run build:types",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "editor": "cd editor && npm run start",
    "build:player": "cd editor && npm run build:player",
    "build:player:only": "cd editor && npm run build:player:only",
    "editor:install": "cd editor && npm ci",
    "editor:dev": "npm run build:dev && npm run build:player:only && concurrently \"npm run watch\" \"npm run editor\"",
    "editor:build": "npm run build:player && cd editor && npm run build",
    "desktop:install": "cd desktop && npm install",
    "desktop:dev": "concurrently \"npm run watch\" \"npm run editor\" \"cd desktop && npm run dev\"",
    "desktop:build": "npm run build && npm run editor:build && cd desktop && npm run dist",
    "test:script-workspace": "cd desktop && npm run e2e:scripts",
    "terrain:decimate": "node --max-old-space-size=8192 tools/terrain/decimateTrees.mjs",
    "build:landscape": "node desktop/node_modules/electron/cli.js tools/terrain/buildLandscape.js",
    "naga:build": "node tools/naga-wasm/build.mjs",
    "harness:mesh": "node desktop/node_modules/electron/cli.js tools/harness/meshCheck.js",
    "harness:pass": "node desktop/node_modules/electron/cli.js tools/harness/passCheck.js",
    "harness:lighting": "node desktop/node_modules/electron/cli.js tools/harness/lightingCheck.js",
    "harness:frametime": "node desktop/node_modules/electron/cli.js tools/harness/frameTime.js",
    "harness:backenddiff": "node desktop/node_modules/electron/cli.js tools/harness/backendDiff.js",
    "harness:backenddiff:full": "node -e \"process.env.CLEO_SCENE='full';require('child_process').spawnSync(process.execPath,['desktop/node_modules/electron/cli.js','tools/harness/backendDiff.js'],{stdio:'inherit',env:process.env})\"",
    "harness:backenddiff:every": "node -e \"process.env.CLEO_SCENE='every';require('child_process').spawnSync(process.execPath,['desktop/node_modules/electron/cli.js','tools/harness/backendDiff.js'],{stdio:'inherit',env:process.env})\"",
    "harness:backenddiff:every:forward": "node -e \"process.env.CLEO_SCENE='every';process.env.CLEO_PIPELINE='forward';require('child_process').spawnSync(process.execPath,['desktop/node_modules/electron/cli.js','tools/harness/backendDiff.js'],{stdio:'inherit',env:process.env})\"",
    "harness:backenddiff:every2d": "node -e \"process.env.CLEO_SCENE='every2d';require('child_process').spawnSync(process.execPath,['desktop/node_modules/electron/cli.js','tools/harness/backendDiff.js'],{stdio:'inherit',env:process.env})\"",
    "harness:backenddiff:every2d:forward": "node -e \"process.env.CLEO_SCENE='every2d';process.env.CLEO_PIPELINE='forward';require('child_process').spawnSync(process.execPath,['desktop/node_modules/electron/cli.js','tools/harness/backendDiff.js'],{stdio:'inherit',env:process.env})\"",
    "harness:backenddiff:forward": "node -e \"process.env.CLEO_PIPELINE='forward';require('child_process').spawnSync(process.execPath,['desktop/node_modules/electron/cli.js','tools/harness/backendDiff.js'],{stdio:'inherit',env:process.env})\"",
    "harness:compare": "node desktop/node_modules/electron/cli.js tools/harness/compareGallery.js",
    "harness:naga": "node desktop/node_modules/electron/cli.js tools/harness/nagaCheck.js",
    "harness:mesh:forward": "node -e \"process.env.CLEO_PIPELINE='forward';require('child_process').spawnSync(process.execPath,['desktop/node_modules/electron/cli.js','tools/harness/meshCheck.js'],{stdio:'inherit',env:process.env})\"",
    "harness:mesh:full": "node -e \"process.env.CLEO_SCENE='full';require('child_process').spawnSync(process.execPath,['desktop/node_modules/electron/cli.js','tools/harness/meshCheck.js'],{stdio:'inherit',env:process.env})\"",
    "harness:mesh:every": "node -e \"process.env.CLEO_SCENE='every';require('child_process').spawnSync(process.execPath,['desktop/node_modules/electron/cli.js','tools/harness/meshCheck.js'],{stdio:'inherit',env:process.env})\"",
    "harness:mesh:full:forward": "node -e \"process.env.CLEO_SCENE='full';process.env.CLEO_PIPELINE='forward';require('child_process').spawnSync(process.execPath,['desktop/node_modules/electron/cli.js','tools/harness/meshCheck.js'],{stdio:'inherit',env:process.env})\"",
    "harness:mesh:every:forward": "node -e \"process.env.CLEO_SCENE='every';process.env.CLEO_PIPELINE='forward';require('child_process').spawnSync(process.execPath,['desktop/node_modules/electron/cli.js','tools/harness/meshCheck.js'],{stdio:'inherit',env:process.env})\"",
    "harness:webgpu:build": "webpack --config tools/harness/webpack.harness.js",
    "harness:webgpu": "npm run harness:webgpu:build && node desktop/node_modules/electron/cli.js tools/harness/webgpuCheck.js",
    "harness:webgpu:boot": "node desktop/node_modules/electron/cli.js tools/harness/webgpuBootCheck.js",
    "harness:uniforms": "node desktop/node_modules/electron/cli.js tools/harness/uniformLayoutCheck.js",
    "harness:coverage": "node -e \"process.env.CLEO_SCENE='full';require('child_process').spawnSync(process.execPath,['desktop/node_modules/electron/cli.js','tools/harness/programCoverage.js'],{stdio:'inherit',env:process.env})\"",
    "harness:coverage:forward": "node -e \"process.env.CLEO_SCENE='full';process.env.CLEO_PIPELINE='forward';require('child_process').spawnSync(process.execPath,['desktop/node_modules/electron/cli.js','tools/harness/programCoverage.js'],{stdio:'inherit',env:process.env})\""
  },
  "author": "Ariel Riveros",
  "license": "ISC",
  "devDependencies": {
    "@types/uuid": "^9.0.7",
    "@types/webgl2": "0.0.10",
    "@vitest/coverage-istanbul": "^3.2.7",
    "@webgpu/types": "^0.1.72",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^14.0.0",
    "file-loader": "^6.2.0",
    "ts-loader": "^9.5.1",
    "ts-shader-loader": "^2.0.2",
    "typescript": "^5.3.2",
    "vitest": "^3.2.7",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "gl-matrix": "3.4.4",
    "sucrase": "^3.35.1",
    "uuid": "^14.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
