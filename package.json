{
  "name": "cleo",
  "version": "1.2.4",
  "description": "WebGL2 Game Engine",
  "types": "dist/cleo.d.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "docs:media": "node tools/docsMedia/run.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "jsdoc:gaps": "node tools/jsdoc-gaps.mjs",
    "watch:types": "node tools/watchTypes.mjs",
    "build": "node tools/buildDist.mjs",
    "build:dev": "npm run build",
    "build:types": "npm run build",
    "editor": "cd applications/editor && npm run start",
    "editor:serve": "cd applications/editor && npm run dev",
    "build:player": "cd applications/editor && npm run build:player",
    "build:player:only": "cd applications/editor && npm run build:player:only",
    "build:sdk": "node tools/buildSdk.mjs",
    "test:project-folders": "node applications/app-kit/desktop/tools/projectFolderE2E.mjs",
    "test:example-folders": "node applications/app-kit/desktop/tools/exampleFolderE2E.mjs",
    "test:updates": "node applications/app-kit/desktop/tools/updatesE2E.mjs",
    "editor:install": "cd applications && npm ci",
    "editor:dev": "node tools/ensurePlayer.mjs && node tools/ensureExamples.mjs && concurrently \"npm run watch:types\" \"npm run editor\"",
    "editor:build": "npm run build:player && node tools/ensureExamples.mjs && cd applications/editor && npm run build",
    "desktop:install": "cd applications/app-kit/desktop && npm install",
    "desktop:dev": "node tools/ensurePlayer.mjs && node tools/ensureExamples.mjs && node tools/ensureDesktop.mjs && concurrently --kill-others --names types,editor,electron \"npm run watch:types\" \"npm run editor:serve\" \"cd applications/app-kit/desktop && npm run dev\"",
    "desktop:build": "npm run build && npm run editor:build && npm run build:sdk && npm run build:host && cd applications/app-kit/desktop && npm run dist",
    "naga:build": "node tools/naga-wasm/build.mjs",
    "brand:icons": "node tools/brandIcons.mjs",
    "apps:install": "cd applications && npm ci",
    "mcp:install": "cd applications/mcp && npm install",
    "host:install": "cd applications/host && npm install",
    "host": "cd applications/host && npm start --",
    "allocator": "cd applications/host && npm run allocator --",
    "build:host": "cd applications/host && npm run build",
    "publish-host": "cd applications/host && npm run publish-host --",
    "host:test": "vitest run --root applications/host",
    "install:all": "npm install && npm run apps:install && npm run desktop:install && npm run mcp:install && npm run host:install && npm run examples:fetch",
    "creator": "cd applications/creator && npm run start",
    "creator:serve": "cd applications/creator && npm run dev",
    "creator:dev": "concurrently \"npm run watch:types\" \"npm run creator\"",
    "creator:build": "cd applications/creator && npm run build",
    "dev:all": "node tools/ensurePlayer.mjs && node tools/ensureExamples.mjs && concurrently \"npm run watch:types\" \"npm run editor\" \"npm run creator:serve\"",
    "test:engine": "vitest run --project engine --project \"engine on *\"",
    "test:examples": "vitest run --project \"example:*\"",
    "examples:fetch": "node tools/examples/data.mjs fetch",
    "examples:status": "node tools/examples/data.mjs status",
    "examples:check": "node tools/examples/data.mjs check",
    "examples:publish": "node tools/examples/data.mjs publish",
    "examples:prune": "node tools/examples/data.mjs prune",
    "examples:bundle": "node tools/examples/gallery.mjs",
    "examples:sync": "node tools/exampleKit/syncScripts.mjs",
    "examples:typecheck": "node tools/examples/typecheck.mjs"
  },
  "author": "Ariel Riveros",
  "license": "ISC",
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/uuid": "^9.0.7",
    "@types/webgl2": "0.0.10",
    "@types/yuka": "^0.7.4",
    "@vitest/coverage-istanbul": "^3.2.7",
    "@webgpu/types": "^0.1.72",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "cannon-es": "^0.20.0",
    "gl-matrix": "3.4.4",
    "howler": "^2.2.4",
    "jolt-physics": "1.1.1",
    "meshoptimizer": "^1.3.0",
    "sucrase": "^3.35.1",
    "uuid": "^14.0.1",
    "yuka": "^0.7.8"
  },
  "engines": {
    "node": ">=22"
  }
}
