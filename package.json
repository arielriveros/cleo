{
  "name": "cleo",
  "version": "1.2.4",
  "description": "WebGL2 Game Engine",
  "main": "cleo.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "jsdoc:gaps": "node tools/jsdoc-gaps.mjs",
    "watch": "webpack --watch",
    "watch:types": "tsc -p tsconfig.json --emitDeclarationOnly --watch --preserveWatchOutput",
    "build": "webpack --mode=production --node-env=production && npm run build:types",
    "build:dev": "webpack --mode=development && npm run build:types",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "editor": "cd editor && npm run start",
    "build:player": "cd editor && npm run build:player",
    "build:player:only": "cd editor && npm run build:player:only",
    "editor:install": "cd editor && npm ci",
    "editor:dev": "npm run build:dev && npm run build:player:only && concurrently \"npm run watch\" \"npm run watch:types\" \"npm run editor\"",
    "editor:build": "npm run build:player && cd editor && npm run build",
    "desktop:install": "cd desktop && npm install",
    "desktop:dev": "concurrently \"npm run watch\" \"npm run watch:types\" \"npm run editor\" \"cd desktop && npm run dev\"",
    "desktop:build": "npm run build && npm run editor:build && cd desktop && npm run dist",
    "naga:build": "node tools/naga-wasm/build.mjs"
  },
  "author": "Ariel Riveros",
  "license": "ISC",
  "devDependencies": {
    "@types/uuid": "^9.0.7",
    "@types/webgl2": "0.0.10",
    "@vitest/coverage-istanbul": "^3.2.7",
    "@webgpu/types": "^0.1.72",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^14.0.0",
    "file-loader": "^6.2.0",
    "ts-loader": "^9.5.1",
    "ts-shader-loader": "^2.0.2",
    "typescript": "^5.3.2",
    "vitest": "^3.2.7",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "gl-matrix": "3.4.4",
    "sucrase": "^3.35.1",
    "uuid": "^14.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
