{
  "name": "cleo",
  "version": "1.2.4",
  "description": "WebGL2 Game Engine",
  "types": "dist/cleo.d.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "jsdoc:gaps": "node tools/jsdoc-gaps.mjs",
    "watch:types": "tsc -p tsconfig.json --emitDeclarationOnly --watch --preserveWatchOutput",
    "build": "node tools/buildDist.mjs",
    "build:dev": "npm run build",
    "build:types": "npm run build",
    "editor": "cd editor && npm run start",
    "build:player": "cd editor && npm run build:player",
    "build:player:only": "cd editor && npm run build:player:only",
    "editor:install": "cd editor && npm ci",
    "editor:dev": "npm run build && npm run build:player:only && concurrently \"npm run watch:types\" \"npm run editor\"",
    "editor:build": "npm run build:player && cd editor && npm run build",
    "desktop:install": "cd desktop && npm install",
    "desktop:dev": "concurrently \"npm run watch:types\" \"npm run editor\" \"cd desktop && npm run dev\"",
    "desktop:build": "npm run build && npm run editor:build && cd desktop && npm run dist",
    "naga:build": "node tools/naga-wasm/build.mjs"
  },
  "author": "Ariel Riveros",
  "license": "ISC",
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/uuid": "^9.0.7",
    "@types/webgl2": "0.0.10",
    "@types/yuka": "^0.7.4",
    "@vitest/coverage-istanbul": "^3.2.7",
    "@webgpu/types": "^0.1.72",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "gl-matrix": "3.4.4",
    "howler": "^2.2.4",
    "sucrase": "^3.35.1",
    "uuid": "^14.0.1",
    "yuka": "^0.7.8"
  },
  "engines": {
    "node": ">=22"
  }
}
