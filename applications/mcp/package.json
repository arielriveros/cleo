  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.319",
    "@anthropic-ai/sdk": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "node-pty": "^1.1.0",
    "ws": "^8.22.1",
    "zod": "^4.1.0"
  }
}
