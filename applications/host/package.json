{
  "name": "cleo-host",
  "version": "0.1.0",
  "private": true,
  "description": "NetSync hosting (docs/design/netsync.md): cleo-host, the dedicated host that runs a game for its players over WebTransport and WebSocket, and cleo-allocator, the allocator and gateway in front of a fleet of them.",
  "type": "module",
  "scripts": {
    "start": "vite-node src/main.ts --",
    "allocator": "vite-node src/allocator/main.ts --",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Ariel Riveros",
  "license": "ISC",
  "dependencies": {
    "@fails-components/webtransport": "1.6.12",
    "@fails-components/webtransport-transport-http3-quiche": "1.6.12",
    "@peculiar/x509": "^3.1.0",
    "reflect-metadata": "^0.2.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0"
  }
}
