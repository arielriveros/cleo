{
  "name": "cleo-desktop",
  "version": "1.2.4",
  "description": "Electron desktop shell (part of the app-kit) hosting the Cleo Editor, with game publishing",
  "main": "main.js",
  "author": "Ariel Riveros",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "dev": "node dev.js",
    "dist": "cross-env ALLOW_ELECTRON_BUILDER_AS_PRODUCTION_DEPENDENCY=true electron-builder --publish never"
  },
  "build": {
    "appId": "com.cleo.editor",
    "productName": "Cleo Editor",
    "files": [
      "main.js",
      "preload.js",
      "gameTemplates.js",
      "gameProtocol.js",
      "gameSaves.js",
      "gamePreload.js",
      "projectFolder.js",
      "safeFs.js",
      "controlPipe.js",
      "sdk/**",
      "movieFiles.js",
      "playWindow.js",
      "devHostProcess.js",
      "windowControls.js",
      "playDebugger.js",
      "debugPort.js",
      "desktopUpdater.js",
      "icons/**",
      "!node_modules/app-builder-bin/!(${os})/**",
      "!node_modules/7zip-bin/!(${os})/**"
    ],
    "asarUnpack": [
      "node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../../editor/dist",
        "to": "editor"
      },
      {
        "from": "../../sdk/dist/cleo",
        "to": "sdk/cleo"
      },
      {
        "from": "../../host/dist",
        "to": "host",
        "filter": [
          "**/*",
          "!**/*.map"
        ]
      },
      {
        "from": "../../host/node_modules",
        "to": "host/node_modules",
        "filter": [
          "**/*",
          "!@types/**",
          "!**/*.d.ts",
          "!**/*.map"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "arielriveros",
        "repo": "cleo"
      }
    ],
    "fileAssociations": [
      {
        "ext": "cleo",
        "name": "Cleo Project",
        "description": "Cleo project",
        "role": "Editor"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "icons/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icons/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Cleo-Editor-Setup-${version}.${ext}"
    },
    "dmg": {
      "artifactName": "Cleo-Editor-${version}-${arch}.${ext}"
    },
    "appImage": {
      "artifactName": "Cleo-Editor-${version}-${arch}.${ext}"
    }
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^31.7.0"
  },
  "dependencies": {
    "electron-builder": "^24.13.3",
    "electron-updater": "^6.8.11"
  }
}
