{
  "name": "cleo-desktop",
  "version": "1.2.4",
  "description": "Electron desktop shell (part of the app-kit) hosting the Cleo Editor, with game publishing",
  "main": "main.js",
  "author": "Ariel Riveros",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env CLEO_DEV=1 electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.cleo.editor",
    "productName": "Cleo Editor",
    "files": [
      "main.js",
      "preload.js",
      "gameTemplates.js",
      "scriptWorkspace.js"
    ],
    "extraResources": [
      {
        "from": "../../editor/dist",
        "to": "editor"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  }
}
